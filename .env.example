PORT=3000

# Required: Google Sheets webhook (see README.md "Google Sheets setup")
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
SHEETS_SECRET=a-long-random-string-shared-with-the-apps-script

# Optional: email notification on each submission (best-effort, non-blocking)
EMAIL_TO=your-inbox@example.com
EMAIL_USER=your-smtp-user@example.com
EMAIL_PASSWORD=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
